# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker compose up -d db). Leave unset to fall back to SQLite for a first look.
DATABASE_URL=postgres://quantum:quantum@localhost:5432/quantumloop

# Redis for background jobs (docker compose up -d redis)
REDIS_URL=redis://localhost:6379/0
