# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker compose up -d db). Leave unset to fall back to SQLite for a first look.
DATABASE_URL=postgres://quantum:quantum@localhost:5432/quantumloop

# Redis for background jobs (docker compose up -d redis)
REDIS_URL=redis://localhost:6379/0

# Per-field encryption (TOTP seeds, bank details). Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
SITE_URL=http://localhost:8000
# Email: console backend in DEBUG; set these for ZeptoMail/SES in production
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=QuantumLoop <no-reply@quantumloop.in>
