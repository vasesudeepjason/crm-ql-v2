# Copy to .env.production on the server. Never commit the real file.
SITE_DOMAIN=app.quantumloop.in
SITE_URL=https://app.quantumloop.in
DJANGO_SECRET_KEY=            # python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=app.quantumloop.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.quantumloop.in
FIELD_ENCRYPTION_KEY=         # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  — back this up separately; losing it loses every encrypted field

# Database: the app connects as quantum_app (no superuser, no BYPASSRLS). Both passwords are set on first boot.
POSTGRES_DB=quantumloop
POSTGRES_SUPERUSER=quantum
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
DATABASE_URL=postgres://quantum_app:${APP_DB_PASSWORD}@db:5432/quantumloop

# Transactional email (ZeptoMail / SES / Postmark SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=QuantumLoop <no-reply@quantumloop.in>

WEB_CONCURRENCY=3
DJANGO_LOG_LEVEL=INFO
